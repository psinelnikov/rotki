# Full build with AGPL modifications
# This builds the complete frontend and backend from source

# Stage 1: Build frontend with SimpleStatistics
FROM --platform=$BUILDPLATFORM node:24-bookworm AS frontend-builder

ENV CYPRESS_INSTALL_BINARY=0
ENV NODE_OPTIONS="--max-old-space-size=8192"

WORKDIR /app

# Copy frontend source
COPY frontend/ .

# Install dependencies and build
RUN npm install -g corepack@latest && \
    corepack enable && \
    pnpm install --frozen-lockfile && \
    pnpm run docker:build

# Stage 2: Backend with modified Python
FROM ghcr.io/astral-sh/uv:python3.11-bookworm AS backend-builder

WORKDIR /app

# Copy Python project files
COPY pyproject.toml uv.lock* ./
RUN uv sync --locked --no-dev --no-install-project

# Copy source with AGPL modifications
COPY rotkehlchen/ ./rotkehlchen/

# Install and verify
RUN uv sync --locked --no-dev --no-install-project && \
    uv pip install -e . && \
    uv run python -c "from rotkehlchen.premium.premium import has_premium_capability; assert has_premium_capability(None, 'test') == True; print('Premium bypass verified')"

# Stage 3: Colibri (Rust)
FROM rust:1-bookworm AS colibri-builder

WORKDIR /app
COPY colibri/ ./colibri
RUN cargo build --target-dir /tmp/dist/colibri --manifest-path ./colibri/Cargo.toml --release

# Stage 4: Final runtime image
FROM nginx:1.30 AS runtime

LABEL maintainer="Self-hosted AGPL version"
LABEL description="Rotki with premium restrictions removed per AGPL-3.0"

RUN apt-get update && \
    apt-get install -y procps python3 --no-install-recommends && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy backend from builder
COPY --from=backend-builder /app/.venv /opt/rotki/.venv
COPY --from=backend-builder /app/rotkehlchen /opt/rotki/rotkehlchen

# Copy colibri
COPY --from=colibri-builder /tmp/dist/colibri/release/colibri /opt/rotki/colibri

# Copy built frontend
COPY --from=frontend-builder /app/app/dist /opt/rotki/frontend

# Create symlinks
RUN ln -s /opt/rotki/.venv/bin/python /usr/local/bin/rotki-python && \
    ln -s /opt/rotki/colibri /usr/local/bin/colibri

# Copy entrypoint and nginx config from packaging
COPY ./packaging/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY ./packaging/docker/entrypoint.py /opt/rotki/

VOLUME ["/data", "/logs", "/config"]
EXPOSE 80

CMD ["/opt/rotki/entrypoint.py"]

HEALTHCHECK CMD ["curl", "--fail", "http://localhost/api/1/ping"]
